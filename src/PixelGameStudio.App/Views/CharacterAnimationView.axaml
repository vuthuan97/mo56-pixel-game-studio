<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PixelGameStudio.App.Views.CharacterAnimationView">
    <StackPanel Spacing="10">
        <Border Classes="card">
            <StackPanel Spacing="5">
                <TextBlock Classes="caption" Text="ANIMATION" />
                <TextBlock Classes="fieldLabel" Text="Display name" />
                <TextBox Text="{Binding AnimationDisplayName, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="FPS" />
                    <TextBox Width="55" Text="{Binding Fps}" />
                    <CheckBox Content="Loop" IsChecked="{Binding Loop}" />
                </StackPanel>
                <TextBlock Classes="note" Text="{Binding DurationSeconds, StringFormat='Duration: {0:0.00}s'}" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Frame ticks" />
                    <TextBox Width="60" Text="{Binding CurrentFrameDurationTicks, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="5">
                <TextBlock Classes="caption" Text="POSE EDITOR" />
                <ComboBox ItemsSource="{Binding PosePartOptions}" SelectedItem="{Binding PoseEditorPart}" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBox Width="55" Text="{Binding PoseEditOffsetX}" />
                    <TextBox Width="55" Text="{Binding PoseEditOffsetY}" />
                    <CheckBox Content="Hidden" IsChecked="{Binding PoseEditHidden}" />
                </StackPanel>
                <TextBox Text="{Binding PoseEditState, Mode=TwoWay}" Watermark="state=value;..." />
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button Content="Load" Command="{Binding LoadPoseEditCommand}" />
                    <Button Classes="primary" Content="Apply pose" Command="{Binding ApplyPoseEditCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
