<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PixelGameStudio.App.ViewModels"
             xmlns:ch="using:PixelGameStudio.Domain.Character"
             x:Class="PixelGameStudio.App.Views.CharacterFrameView">
    <StackPanel Spacing="10">
        <Border Classes="card">
            <StackPanel Spacing="5">
                <TextBlock Classes="caption" Text="CHARACTER / FRAME" />
                <TextBlock Classes="fieldLabel" Text="Name" />
                <TextBox Text="{Binding Name, Mode=TwoWay}" />
                <TextBlock Classes="fieldLabel" Text="Notes" />
                <TextBox Text="{Binding Notes, Mode=TwoWay}" AcceptsReturn="True" Height="64" />
            </StackPanel>
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="6">
                <TextBlock Classes="caption" Text="THÂN" />
                <TextBlock Classes="fieldLabel" Text="Giới tính" />
                <ComboBox ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding Gender}" />
                <TextBlock Classes="fieldLabel" Text="Vóc dáng" />
                <ComboBox ItemsSource="{Binding BodyTypeOptions}" SelectedItem="{Binding BodyType}" />
                <TextBlock Classes="fieldLabel" Text="Kiểu thân" />
                <ComboBox ItemsSource="{Binding BodyVariantOptions}" SelectedItem="{Binding BodyVariant}" />
                <TextBlock Classes="fieldLabel" Text="Màu da" />
                <ComboBox ItemsSource="{Binding SkinToneOptions}" SelectedItem="{Binding SkinTone}" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Width="78" VerticalAlignment="Center" Text="Thân cao" />
                    <Slider Width="150" Minimum="8" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TorsoHeightSlider, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding TorsoHeightPx, StringFormat='{}{0} px'}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="6">
                <TextBlock Classes="caption" Text="KHUÔN MẶT" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Width="78" VerticalAlignment="Center" Text="Đầu cao" />
                    <Slider Width="150" Minimum="8" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding HeadHeightSlider, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding HeadHeightPx, StringFormat='{}{0} px'}" />
                </StackPanel>
                <TextBlock Classes="fieldLabel" Text="Mắt" />
                <ComboBox ItemsSource="{Binding EyeStyleOptions}" SelectedItem="{Binding EyeStyle}" />
                <TextBlock Classes="fieldLabel" Text="Miệng" />
                <ComboBox ItemsSource="{Binding MouthStyleOptions}" SelectedItem="{Binding MouthStyle}" />
            </StackPanel>
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="6">
                <TextBlock Classes="caption" Text="TÓC" />
                <ComboBox ItemsSource="{Binding HairStyleOptions}" SelectedItem="{Binding HairStyle}" />
            </StackPanel>
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="6">
                <TextBlock Classes="caption" Text="TAY" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Width="78" VerticalAlignment="Center" Text="Chiều dài" />
                    <Slider Width="150" Minimum="6" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ArmLengthSlider, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding ArmLengthPx, StringFormat='{}{0} px'}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="6">
                <TextBlock Classes="caption" Text="CHÂN" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Width="78" VerticalAlignment="Center" Text="Chiều dài" />
                    <Slider Width="150" Minimum="8" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LegLengthSlider, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding LegLengthPx, StringFormat='{}{0} px'}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Width="78" VerticalAlignment="Center" Text="Bàn chân" />
                    <Slider Width="150" Minimum="2" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FootWidthSlider, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding FootWidthPx, StringFormat='{}{0} px'}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="5">
                <TextBlock Classes="caption" Text="RIG ADVANCED" />
                <TextBlock Classes="note" Text="{Binding Rig.RigDisplayName}" />
                <ListBox MinHeight="80" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding Rig.Parts}" SelectedItem="{Binding Rig.SelectedPart}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Width="24" Text="{Binding ZIndex}" Foreground="{StaticResource TextFaintBrush}" />
                                <TextBlock Text="{Binding DisplayName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBox Text="{Binding Rig.PartDisplayName, Mode=TwoWay}" />
                <Grid ColumnDefinitions="30,*,48" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                    <TextBlock VerticalAlignment="Center" Text="Z" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Rig.PartZIndexSlider, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Rig.PartZIndex}" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="dX" />
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="-32" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Rig.PartOffsetXSlider, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Rig.PartOffsetX}" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="dY" />
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="-32" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Rig.PartOffsetYSlider, Mode=TwoWay}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Rig.PartOffsetY}" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
